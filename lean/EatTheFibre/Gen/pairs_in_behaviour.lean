      _ = Ψ * (Φ * evalM (thm3FP i) t) * Ψ := by rw [hc]
      _ = (Ψ * Φ) * evalM (thm3FP i) t * Ψ := by simp only [Matrix.mul_assoc]
      _ = evalM (thm3FP i) t * Ψ := by rw [h2, Matrix.one_mul]
  fin_cases i <;> fin_cases j <;> simp only [thm3FP, Fin.isValue, Matrix.cons_val, Fin.reduceFinMk] at hc hc'
