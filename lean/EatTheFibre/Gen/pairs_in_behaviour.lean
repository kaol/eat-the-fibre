/-- **F1, F2, F3, F4 are four behaviours modulo Inn ⋊ Sub** (nonzero parameters). -/
theorem thm3_behaviours_distinct {Φ Ψ : Matrix (Fin 7) (Fin 7) k} (hΦ : Filt Φ) (hΨ : Filt Ψ)
    (h1 : Φ * Ψ = 1) (h2 : Ψ * Φ = 1) {t t' : k} (ht : t ≠ 0) (ht' : t' ≠ 0) (i j : Fin 4)
    (hc : Φ * evalM (thm3FP i) t = evalM (thm3FP j) t' * Φ) : i = j := by
  have hc' : Ψ * evalM (thm3FP j) t' = evalM (thm3FP i) t * Ψ := by
    calc Ψ * evalM (thm3FP j) t' = Ψ * evalM (thm3FP j) t' * (Φ * Ψ) := by rw [h1, Matrix.mul_one]
