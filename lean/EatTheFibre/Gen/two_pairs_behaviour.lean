/-- **The nineteen families of 1⇉2⇉3 are nineteen behaviours.** If mutually inverse filtered matrices (for example
products of class substitutions and inner automorphisms) intertwine member `t` of family `i` with member `t'` of
family `j`, then `i = j`. -/
theorem fam_behaviours_distinct {Φ Ψ : Matrix (Fin 11) (Fin 11) k} (hΦ : Filt Φ) (hΨ : Filt Ψ)
    (h1 : Φ * Ψ = 1) (h2 : Ψ * Φ = 1) {t t' : k} (i j : Fin 19)
    (hc : Φ * evalM (famP i) t = evalM (famP j) t' * Φ) : i = j := by
  have hc' : Ψ * evalM (famP j) t' = evalM (famP i) t * Ψ := by
    calc Ψ * evalM (famP j) t' = Ψ * evalM (famP j) t' * (Φ * Ψ) := by rw [h1, Matrix.mul_one]
      _ = Ψ * (evalM (famP j) t' * Φ) * Ψ := by simp only [Matrix.mul_assoc]
      _ = Ψ * (Φ * evalM (famP i) t) * Ψ := by rw [hc]
      _ = (Ψ * Φ) * evalM (famP i) t * Ψ := by simp only [Matrix.mul_assoc]
      _ = evalM (famP i) t * Ψ := by rw [h2, Matrix.one_mul]
  fin_cases i <;> fin_cases j <;> simp only [famP, Fin.isValue, Matrix.cons_val, Fin.reduceFinMk] at hc hc'
  · rfl
  · exact (fam1P_fam2P_behav hΦ hΨ hc hc').elim
  · exact (fam1P_fam3P_behav hΦ hΨ hc hc').elim
  · exact (fam1P_fam4P_behav hΦ hΨ hc hc').elim
  · exact (fam1P_fam5P_behav hΦ hΨ hc hc').elim
