theorem thm3F3_del_4 : deltaOK D thm3F3P 4 = true := by decide +kernel
theorem thm3F3_del_5 : deltaOK D thm3F3P 5 = true := by decide +kernel
theorem thm3F3_del_6 : deltaOK D thm3F3P 6 = true := by decide +kernel

theorem thm3F3_check : check c D thm3F3P = true :=
  check_of_parts c D thm3F3P thm3F3_idem
    (fun i => by fin_cases i; exacts [thm3F3_img_0, thm3F3_img_1, thm3F3_img_2, thm3F3_img_3, thm3F3_img_4, thm3F3_img_5, thm3F3_img_6])
    (fun i => by fin_cases i; exacts [thm3F3_ker_0, thm3F3_ker_1, thm3F3_ker_2, thm3F3_ker_3, thm3F3_ker_4, thm3F3_ker_5, thm3F3_ker_6])
    (fun i => by fin_cases i; exacts [thm3F3_del_0, thm3F3_del_1, thm3F3_del_2, thm3F3_del_3, thm3F3_del_4, thm3F3_del_5, thm3F3_del_6])

/-- **Theorem 3, family F3 (u = 3, v = 2, w = 1); parameter s written t** is a fold, over every commutative ring and for every `t`. -/
theorem thm3F3_isFold {k : Type*} [CommRing k] (t : k) :
    (alg k).IsFold (evalM thm3F3P t) :=
  check_sound c D thm3F3P t thm3F3_check

/-- the image of the basis path `e1` -/
theorem thm3F3_e1 {k : Type*} [CommRing k] (t : k) :
    evalM thm3F3P t *ᵥ Pi.single 0 1 = ![0, t, (-1), (-1), (1), (-t) + (-1), t + (1)] := by
  rw [col_eval]; funext i; fin_cases i <;> simp [thm3F3P] <;> ring

/-- the image of the basis path `e3` -/
theorem thm3F3_e3 {k : Type*} [CommRing k] (t : k) :
    evalM thm3F3P t *ᵥ Pi.single 2 1 = ![0, (-t), (1), (1), (-1), t + (1), (-t) + (-1)] := by
  rw [col_eval]; funext i; fin_cases i <;> simp [thm3F3P] <;> ring

/-- the image of the basis path `a2` -/
theorem thm3F3_a2 {k : Type*} [CommRing k] (t : k) :
    evalM thm3F3P t *ᵥ Pi.single 4 1 = ![0, t ^ 2 + t, 0, (-t) + (-1), t + (1), (-t ^ 2) + (-t), t ^ 2 + t] := by
  rw [col_eval]; funext i; fin_cases i <;> simp [thm3F3P] <;> ring

/-- the image of the basis path `b2` -/
theorem thm3F3_b2 {k : Type*} [CommRing k] (t : k) :
    evalM thm3F3P t *ᵥ Pi.single 6 1 = ![0, (-t), 0, (1), (-1), t, (-t)] := by
  rw [col_eval]; funext i; fin_cases i <;> simp [thm3F3P] <;> ring

/-- every other basis path is killed: e2, a1, b1 -/
theorem thm3F3_kills {k : Type*} [CommRing k] (t : k) :
    ∀ j ∈ ([1, 3, 5] : List (Fin 7)), evalM thm3F3P t *ᵥ Pi.single j 1 = 0 := by
  intro j hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl <;>
    (rw [col_eval]; funext i; fin_cases i <;> simp [thm3F3P])


