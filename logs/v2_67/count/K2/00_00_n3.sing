LIB "primdec.lib";
ring R = 0,(k02,k12,k20,k21,k22,y3_0),dp;
option(redSB);
matrix XI[3][6] = k02,k12,-k20,-k21,0,-k22 - y3_0,-k02,-k12,k20,k21,0,y3_0,-k02,-k12,k20,k21,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 6; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal I = k22-1,k21,k20,k12,k02;
ideal G = std(I); int a; int i; poly g;
poly f = -y3_0;
if (reduce(f, G) == 0) { print("FININ"); print("END"); quit; }
G = std(G + f); ideal NEW = f; int rounds = 0;
while (size(NEW) > 0) { rounds++; ideal NX = 0; for (i = 1; i <= size(NEW); i++) { for (a = 1; a <= 3; a++) { g = reduce(xi(NEW[i], a), G); if (g != 0) { NX = NX + g; G = std(G + g); } } } NEW = simplify(NX, 2); kill NX; }
print("CLOSED " + string(rounds) + " DIM " + string(dim(G)));
list L = minAssGTZ(G);
for (i = 1; i <= size(L); i++) { ideal Gi = std(L[i]); print("COMP " + string(dim(Gi))); print("GENS " + string(Gi)); intvec iv = indepSet(Gi); print("INDEP " + string(iv)); kill iv; kill Gi; }
print("END"); quit;