LIB "primdec.lib";
ring R = 0,(k02,k12,k20,k21,k22,y3_0),dp;
option(redSB);
matrix XI[3][6] = k02,k12,-k20,-k21,0,-k22 - y3_0,-k02,-k12,k20,k21,0,y3_0,-k02,-k12,k20,k21,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 6; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(k22 - 1,k21,k20,k02));
print("DIM " + string(dim(G)));
intvec iv = indepSet(G); print("INDEP " + string(iv));
print("END"); quit;