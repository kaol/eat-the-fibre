LIB "primdec.lib";
ring R = 0,(k12,k20,k22,y3_0),dp;
option(redSB);
matrix XI[3][4] = k12,-k20,0,-k22 - y3_0,-k12,k20,0,y3_0,-k12,k20,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 4; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y3_0,k22,k20,k12));
print("VDIM " + string(vdim(G)));
print("END"); quit;