ring R = 0,(k30,k40,y0_2,y0_3,y0_4,y1_2,y1_3,y1_4,y2_2,y2_3,y2_4,y4_1,y4_2,y4_3,y4_4,y5_1,y5_2,y5_3,y5_4,y6_2,y6_3,y6_4,y8_1,y8_2,y8_3,y8_4,y9_1,y9_2,y9_3,y9_4),dp;
