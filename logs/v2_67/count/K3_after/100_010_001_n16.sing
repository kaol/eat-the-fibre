LIB "primdec.lib";
ring R = 0,(y0_2,y0_3,y0_4,y1_2,y1_3,y1_4,y2_2,y2_3,y2_4,y4_2,y4_3,y4_4,y5_2,y5_3,y5_4,y6_2,y6_3,y6_4,y8_2,y8_3,y8_4,y9_2,y9_3,y9_4),dp;
option(redSB);
matrix XI[8][24] = y0_2 - y0_3,0,0,y1_2 - y1_3,0,0,y2_2 - y2_3,0,0,-y4_3 - y5_2,-y4_3 - y5_3,-y4_4 - y5_4,y5_2 - y5_3,0,0,y6_2 - y6_3,0,0,-y8_3 - y9_2 + 1,-y8_3 - y9_3 + 1,-y8_4 - y9_4 + 1,y9_2 - y9_3,0,0,0,y0_2 - y0_3,0,0,y1_2 - y1_3,0,0,y2_2 - y2_3,0,y4_2,y4_2,y4_4,0,y5_2 - y5_3,0,0,y6_2 - y6_3,0,y8_2,y8_2,y8_4,0,y9_2 - y9_3,0,0,0,y0_2 - y0_3,0,0,y1_2 - y1_3,0,0,y2_2 - y2_3,y5_2,y5_3,y4_2 - y4_3 + y5_4,0,0,y5_2 - y5_3,0,0,y6_2 - y6_3,y9_2,y9_3,y8_2 - y8_3 + y9_4,0,0,y9_2 - y9_3,y0_2 - y0_4,0,0,y1_2 - y1_4,0,0,y2_2 - y2_4,0,0,y4_2 - y4_4,0,0,-y4_2 - y5_4,-y4_3 - y5_3,-y4_4 - y5_4,y6_2 - y6_4,0,0,y8_2 - y8_4,0,0,-y8_2 - y9_4 + 1,-y8_3 - y9_3 + 1,-y8_4 - y9_4 + 1,0,y0_2 - y0_4,0,0,y1_2 - y1_4,0,0,y2_2 - y2_4,0,0,y4_2 - y4_4,0,y4_2,y4_3 + y5_2 - y5_4,y4_4,0,y6_2 - y6_4,0,0,y8_2 - y8_4,0,y8_2,y8_3 + y9_2 - y9_4,y8_4,0,0,y0_2 - y0_4,0,0,y1_2 - y1_4,0,0,y2_2 - y2_4,0,0,y4_2 - y4_4,y5_2,y5_3,y5_2,0,0,y6_2 - y6_4,0,0,y8_2 - y8_4,y9_2,y9_3,y9_2,-y0_2,-y0_3,-y0_4,-y1_2,-y1_3,-y1_4,-y2_2,-y2_3,-y2_4,0,0,0,0,0,0,-y6_2,-y6_3,-y6_4,0,0,0,0,0,0,-y0_2,-y0_3,-y0_4,-y1_2,-y1_3,-y1_4,-y2_2,-y2_3,-y2_4,-y4_2,-y4_3,-y4_4,-y5_2,-y5_3,-y5_4,0,0,0,0,0,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 24; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal I = y8_2 - y8_3 + y9_2 - y9_4 + 1,y5_4,y5_3,y5_2,y4_4,y4_3,y4_2,y2_4,y2_3,y2_2,y1_4,y1_3,y1_2,y0_4,y0_3,y0_2,-y8_3*y9_4 + y8_3 + y8_4*y9_3 + y9_4 - 1,-y6_3*y9_4 + y6_3 + y6_4*y9_3,-y8_3*y9_4 + y8_3 + y8_4*y9_2 + y9_2*y9_4 - y9_2 - y9_4^2 + 2*y9_4 - 1,y8_3*y9_2 - y8_3*y9_3 + y9_2*y9_3 - y9_2 - y9_3*y9_4 + y9_3,-y6_2*y9_4 + y6_2 + y6_4*y9_2,-y6_2*y9_3 + y6_3*y9_2,y6_2*y8_4 + y6_2*y9_4 - y6_2 - y6_3*y8_4 - y6_4*y9_4,-y6_3*y8_4 + y6_4*y8_3 - y6_4,y6_2*y8_3 + y6_2*y9_3 - y6_2 - y6_3*y8_3 - y6_3*y9_4 + y6_3;
ideal G = std(I); int a; int i; poly g;
poly f = -y6_2^3*y9_2 + y6_2^2*y6_3*y9_2 + y6_2^2*y6_4*y9_2 - y6_2*y6_3*y6_4*y9_2;
if (reduce(f, G) == 0) { print("FININ"); print("END"); quit; }
for (i = 1; i <= size(I); i++) { for (a = 1; a <= 8; a++) { if (reduce(xi(I[i], a), G) != 0) { print("NOTTANGENT " + string(i) + " " + string(a)); print("END"); quit; } } }
G = std(G + f); ideal NEW = f; int rounds = 0;
while (size(NEW) > 0) { rounds++; ideal NX = 0; for (i = 1; i <= size(NEW); i++) { for (a = 1; a <= 8; a++) { g = reduce(xi(NEW[i], a), G); if (g != 0) { NX = NX + g; G = std(G + g); } } } NEW = simplify(NX, 2); kill NX; }
print("CLOSED " + string(rounds) + " DIM " + string(dim(G)));
list L = minAssGTZ(G);
for (i = 1; i <= size(L); i++) { ideal Gi = std(L[i]); print("COMP " + string(dim(Gi))); print("GENS " + string(Gi)); intvec iv = indepSet(Gi); print("INDEP " + string(iv)); kill iv; kill Gi; }
print("END"); quit;