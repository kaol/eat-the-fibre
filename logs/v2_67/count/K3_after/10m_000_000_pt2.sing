LIB "primdec.lib";
ring R = 0,(k32,k42),dp;
option(redSB);
matrix XI[8][2] = -k32 - k42,0,k32,0,k42,0,0,-k32 - k42,0,k32,0,k42,k32,k42,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 2; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(k42,k32));
print("VDIM " + string(vdim(G)));
print("END"); quit;