LIB "primdec.lib";
ring R = 0,(k03,k04,k23,k24,k33,k34,k43,k44,y4_0,y5_0),dp;
option(redSB);
matrix XI[7][10] = k03,k03,k23,k23,-k43,k33 - k34 - k44,k43,k43,-k33 - y4_0 - y5_0,-k43,-k03,0,-k23,0,0,k34,-k43,0,y4_0,0,0,-k03,0,-k23,k43,-k33 + k44,0,-k43,y5_0,0,k04,k04,k24,k24,k34,k34,-k33 - k43 + k44,-k34,-k34,-k44 - y4_0 - y5_0,-k04,0,-k24,0,-k34,0,k33 - k44,k34,0,y4_0,0,-k04,0,-k24,0,-k34,k43,0,0,y5_0,-k03,-k04,-k23,-k24,0,0,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 10; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y5_0,y4_0,k44,k43,k34,k33,k24,k23,k04,k03));
print("VDIM " + string(vdim(G)));
print("END"); quit;