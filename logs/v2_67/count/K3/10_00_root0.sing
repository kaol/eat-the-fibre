LIB "primdec.lib";
ring R = 0,(k02,k03,k12,k13,k20,k22,k23,k30,k32,k33,y3_0,y4_0),dp;
option(redSB);
matrix XI[7][12] = k02,k02,k12,k12,-k20 - k30,-k32,k22 - k23 - k33,0,k32,k32,-k22 - y3_0 - y4_0,-k32,-k02,0,-k12,0,k20,0,k23,0,-k32,0,y3_0,0,0,-k02,0,-k12,k30,k32,-k22 + k33,0,0,-k32,y4_0,0,k03,k03,k13,k13,0,k23,k23,-k20 - k30,-k22 - k32 + k33,-k23,-k23,-k33 - y3_0 - y4_0,-k03,0,-k13,0,0,-k23,0,k20,k22 - k33,k23,0,y3_0,0,-k03,0,-k13,0,0,-k23,k30,k32,0,0,y4_0,-k02,-k03,-k12,-k13,k20,0,0,k30,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 12; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(k22 + k33 - 1,k13,k12,k03,k02,-k23*y4_0 + k33*y3_0,k32*y3_0 + k33*y4_0 - y4_0,k23*k32 + k33^2 - k33,k20*k32 + k30*k33,-k20*k33 + k20 + k23*k30));
print("DIM " + string(dim(G)));
intvec iv = indepSet(G); print("INDEP " + string(iv));
print("END"); quit;