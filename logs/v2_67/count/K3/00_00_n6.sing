LIB "primdec.lib";
ring R = 0,(k02,k03,k12,k13,k20,k21,k22,k23,k30,k31,k32,k33,y3_0,y4_0),dp;
option(redSB);
matrix XI[7][14] = k02,k02,k12,k12,-k20 - k30,-k21 - k31,-k32,k22 - k23 - k33,0,0,k32,k32,-k22 - y3_0 - y4_0,-k32,-k02,0,-k12,0,k20,k21,0,k23,0,0,-k32,0,y3_0,0,0,-k02,0,-k12,k30,k31,k32,-k22 + k33,0,0,0,-k32,y4_0,0,k03,k03,k13,k13,0,0,k23,k23,-k20 - k30,-k21 - k31,-k22 - k32 + k33,-k23,-k23,-k33 - y3_0 - y4_0,-k03,0,-k13,0,0,0,-k23,0,k20,k21,k22 - k33,k23,0,y3_0,0,-k03,0,-k13,0,0,0,-k23,k30,k31,k32,0,0,y4_0,-k02,-k03,-k12,-k13,k20,k21,0,0,k30,k31,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 14; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal I = k33 - 1,k32,k31,k30,k23,k22 - 1,k21,k20,k03,k02;
ideal G = std(I); int a; int i; poly g;
poly f = k12^2*k13*y3_0*y4_0 + k12*k13^2*y4_0^2;
if (reduce(f, G) == 0) { print("FININ"); print("END"); quit; }
for (i = 1; i <= size(I); i++) { for (a = 1; a <= 7; a++) { if (reduce(xi(I[i], a), G) != 0) { print("NOTTANGENT " + string(i) + " " + string(a)); print("END"); quit; } } }
G = std(G + f); ideal NEW = f; int rounds = 0;
while (size(NEW) > 0) { rounds++; ideal NX = 0; for (i = 1; i <= size(NEW); i++) { for (a = 1; a <= 7; a++) { g = reduce(xi(NEW[i], a), G); if (g != 0) { NX = NX + g; G = std(G + g); } } } NEW = simplify(NX, 2); kill NX; }
print("CLOSED " + string(rounds) + " DIM " + string(dim(G)));
list L = minAssGTZ(G);
for (i = 1; i <= size(L); i++) { ideal Gi = std(L[i]); print("COMP " + string(dim(Gi))); print("GENS " + string(Gi)); intvec iv = indepSet(Gi); print("INDEP " + string(iv)); kill iv; kill Gi; }
print("END"); quit;