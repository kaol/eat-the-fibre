LIB "primdec.lib";
ring R = 0,(k02,k03,k21,k22,k23,k31,k32,k33,y3_0,y4_0),dp;
option(redSB);
matrix XI[7][10] = k02,k02,-k21 - k31,-k32,k22 - k23 - k33,0,k32,k32,-k22 - y3_0 - y4_0,-k32,-k02,0,k21,0,k23,0,-k32,0,y3_0,0,0,-k02,k31,k32,-k22 + k33,0,0,-k32,y4_0,0,k03,k03,0,k23,k23,-k21 - k31,-k22 - k32 + k33,-k23,-k23,-k33 - y3_0 - y4_0,-k03,0,0,-k23,0,k21,k22 - k33,k23,0,y3_0,0,-k03,0,0,-k23,k31,k32,0,0,y4_0,-k02,-k03,k21,0,0,k31,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 10; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y4_0,y3_0,k33,k32,k31,k23,k22,k21,k03,k02));
print("VDIM " + string(vdim(G)));
print("END"); quit;