LIB "primdec.lib";
ring R = 0,(k03,k13,k23,k30,k33,y4_0),dp;
option(redSB);
matrix XI[4][6] = k03,k13,k23,-k30,0,-k33 - y4_0,-k03,-k13,-k23,k30,0,y4_0,-k03,-k13,-k23,k30,0,0,0,0,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 6; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y4_0,k33,k23,k13,k03));
print("DIM " + string(dim(G)));
intvec iv = indepSet(G); print("INDEP " + string(iv));
print("END"); quit;