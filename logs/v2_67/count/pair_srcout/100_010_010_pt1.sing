LIB "primdec.lib";
ring R = 0,(k03,k13,k23,k33,y4_0),dp;
option(redSB);
matrix XI[3][5] = k03,k13,k23,0,-k33 - y4_0 + 1,-k03,-k13,-k23,0,y4_0,-k03,-k13,-k23,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 5; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y4_0,k33 - 1,k23,k13,k03));
print("VDIM " + string(vdim(G)));
print("END"); quit;