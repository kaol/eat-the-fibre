LIB "primdec.lib";
ring R = 0,(k40),dp;
option(redSB);
matrix XI[5][1] = -k40,k40,k40,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 1; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(0));
print("DIM " + string(dim(G)));
intvec iv = indepSet(G); print("INDEP " + string(iv));
print("END"); quit;