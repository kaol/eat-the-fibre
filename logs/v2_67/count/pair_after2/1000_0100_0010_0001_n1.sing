LIB "primdec.lib";
ring R = 0,(y0_6,y0_7,y1_6,y1_7,y2_6,y2_7,y3_6,y3_7,y5_6,y5_7,y6_3,y6_4,y7_6,y7_7,y9_3,y9_4),dp;
option(redSB);
matrix XI[5][16] = y0_6 - y0_7,0,y1_6 - y1_7,0,y2_6 - y2_7,0,y3_6 - y3_7,0,-y5_7,-y5_7,y6_3 - y6_4,0,y7_6 - y7_7,0,-y9_4 + 1,-y9_4 + 1,0,y0_6 - y0_7,0,y1_6 - y1_7,0,y2_6 - y2_7,0,y3_6 - y3_7,y5_6,y5_6,0,y6_3 - y6_4,0,y7_6 - y7_7,y9_3,y9_3,-y0_6,-y0_7,-y1_6,-y1_7,-y2_6,-y2_7,-y3_6,-y3_7,0,0,-y6_3,-y6_4,-y7_6,-y7_7,0,0,-y0_6,-y0_7,-y1_6,-y1_7,-y2_6,-y2_7,-y3_6,-y3_7,-y5_6,-y5_7,0,0,-y7_6,-y7_7,0,0,-y0_6,-y0_7,-y1_6,-y1_7,-y2_6,-y2_7,-y3_6,-y3_7,-y5_6,-y5_7,0,0,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 16; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal I = y9_3 - y9_4,y7_7,y7_6,y6_4,y6_3,y5_7,y5_6,y3_7,y3_6,y1_7 - y2_7,y1_6 - y2_6,y0_7 - y2_7,y0_6 - y2_6,y2_6*y9_4 - y2_6 - y2_7*y9_4;
ideal G = std(I); int a; int i; poly g;
poly f = -y0_6*y9_3;
if (reduce(f, G) == 0) { print("FININ"); print("END"); quit; }
for (i = 1; i <= size(I); i++) { for (a = 1; a <= 5; a++) { if (reduce(xi(I[i], a), G) != 0) { print("NOTTANGENT " + string(i) + " " + string(a)); print("END"); quit; } } }
G = std(G + f); ideal NEW = f; int rounds = 0;
while (size(NEW) > 0) { rounds++; ideal NX = 0; for (i = 1; i <= size(NEW); i++) { for (a = 1; a <= 5; a++) { g = reduce(xi(NEW[i], a), G); if (g != 0) { NX = NX + g; G = std(G + g); } } } NEW = simplify(NX, 2); kill NX; }
print("CLOSED " + string(rounds) + " DIM " + string(dim(G)));
list L = minAssGTZ(G);
for (i = 1; i <= size(L); i++) { ideal Gi = std(L[i]); print("COMP " + string(dim(Gi))); print("GENS " + string(Gi)); intvec iv = indepSet(Gi); print("INDEP " + string(iv)); kill iv; kill Gi; }
print("END"); quit;