LIB "primdec.lib";
ring R = 0,(k13,k23,k30,k33,y4_0),dp;
option(redSB);
matrix XI[4][5] = k13,k23,-k30,0,-k33 - y4_0,-k13,-k23,k30,0,y4_0,-k13,-k23,k30,0,0,0,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 5; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y4_0,k33,k30,k23,k13));
print("VDIM " + string(vdim(G)));
print("END"); quit;