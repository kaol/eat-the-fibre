LIB "primdec.lib";
ring R = 0,(y0_2,y0_3,y1_2,y1_3,y2_2,y2_3,y4_2,y4_3,y5_2,y5_3,y7_2,y7_3),dp;
option(redSB);
matrix XI[4][12] = y0_2 - y0_3,0,y1_2 - y1_3,0,y2_2 - y2_3,0,-y4_3,-y4_3,y5_2 - y5_3,0,-y7_3 + 1,-y7_3 + 1,0,y0_2 - y0_3,0,y1_2 - y1_3,0,y2_2 - y2_3,y4_2,y4_2,0,y5_2 - y5_3,y7_2,y7_2,-y0_2,-y0_3,-y1_2,-y1_3,-y2_2,-y2_3,0,0,-y5_2,-y5_3,0,0,-y0_2,-y0_3,-y1_2,-y1_3,-y2_2,-y2_3,-y4_2,-y4_3,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 12; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal I = y7_2 - y7_3,y5_3,y5_2,y4_3,y4_2,y2_3,y2_2,y1_3,y1_2,y0_2*y7_3 - y0_2 - y0_3*y7_3;
ideal G = std(I); int a; int i; poly g;
poly f = -y0_2*y7_2;
if (reduce(f, G) == 0) { print("FININ"); print("END"); quit; }
for (i = 1; i <= size(I); i++) { for (a = 1; a <= 4; a++) { if (reduce(xi(I[i], a), G) != 0) { print("NOTTANGENT " + string(i) + " " + string(a)); print("END"); quit; } } }
G = std(G + f); ideal NEW = f; int rounds = 0;
while (size(NEW) > 0) { rounds++; ideal NX = 0; for (i = 1; i <= size(NEW); i++) { for (a = 1; a <= 4; a++) { g = reduce(xi(NEW[i], a), G); if (g != 0) { NX = NX + g; G = std(G + g); } } } NEW = simplify(NX, 2); kill NX; }
print("CLOSED " + string(rounds) + " DIM " + string(dim(G)));
list L = minAssGTZ(G);
for (i = 1; i <= size(L); i++) { ideal Gi = std(L[i]); print("COMP " + string(dim(Gi))); print("GENS " + string(Gi)); intvec iv = indepSet(Gi); print("INDEP " + string(iv)); kill iv; kill Gi; }
print("END"); quit;