LIB "primdec.lib";
ring R = 0,(k13,k23,k30,k33,y2_2,y2_3,y4_0,y4_2,y4_3),dp;
option(redSB);
matrix XI[4][9] = k13,k23,-k30,0,y2_2 - y2_3,0,-k33 - y4_0,-y4_3,-y4_3,-k13,-k23,k30,0,0,y2_2 - y2_3,y4_0,y4_2,y4_2,-k13,-k23,k30,0,-y2_2,-y2_3,0,0,0,0,0,0,0,-y2_2,-y2_3,0,-y4_2,-y4_3;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 9; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y4_3,y4_2,y2_3,y2_2,k33 - 1,k30,k13 - k23));
print("DIM " + string(dim(G)));
intvec iv = indepSet(G); print("INDEP " + string(iv));
print("END"); quit;