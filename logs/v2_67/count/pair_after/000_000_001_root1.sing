LIB "primdec.lib";
ring R = 0,(k30,y0_2,y0_3,y1_2,y1_3,y2_2,y2_3,y4_1,y4_2,y4_3,y5_2,y5_3,y7_1,y7_2,y7_3),dp;
option(redSB);
matrix XI[4][15] = -k30,y0_2 - y0_3,0,y1_2 - y1_3,0,y2_2 - y2_3,0,-y4_1,-y4_3,-y4_3,y5_2 - y5_3,0,-y7_1,-y7_3,-y7_3,k30,0,y0_2 - y0_3,0,y1_2 - y1_3,0,y2_2 - y2_3,y4_1,y4_2,y4_2,0,y5_2 - y5_3,y7_1,y7_2,y7_2,k30,-y0_2,-y0_3,-y1_2,-y1_3,-y2_2,-y2_3,y4_1,0,0,-y5_2,-y5_3,y7_1,0,0,0,-y0_2,-y0_3,-y1_2,-y1_3,-y2_2,-y2_3,-y4_1,-y4_2,-y4_3,0,0,0,0,0;
proc xi(poly h, int a) { poly g = 0; int b; for (b = 1; b <= 15; b++) { g = g + diff(h, var(b)) * XI[a, b]; } return(g); }
ideal G = std(ideal(y7_3,y7_2,y7_1,y5_3,y5_2,y4_3,y4_2,y4_1,y2_3,y2_2,y1_3,y1_2,y0_3,y0_2,k30));
print("DIM " + string(dim(G)));
intvec iv = indepSet(G); print("INDEP " + string(iv));
print("END"); quit;